From 4b623b877881bacb78b4b4328a14be76aec95b75 Mon Sep 17 00:00:00 2001
From: Andreas Rehn <rehn.andreas86@gmail.com>
Date: Wed, 17 Jul 2024 22:17:41 +0200
Subject: [PATCH] u-boot: enable Lichee Pi Zero Dock ethernet0

Upstream-Status: Inappropriate [custom machine not upstreamed]
---
 arch/arm/dts/sun8i-v3s-licheepi-zero.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm/dts/sun8i-v3s-licheepi-zero.dts b/arch/arm/dts/sun8i-v3s-licheepi-zero.dts
index 7b8fd31cad..8fdc7be1c7 100644
--- a/arch/arm/dts/sun8i-v3s-licheepi-zero.dts
+++ b/arch/arm/dts/sun8i-v3s-licheepi-zero.dts
@@ -49,6 +49,7 @@
 	compatible = "licheepi,licheepi-zero", "allwinner,sun8i-v3s";
 
 	aliases {
+		ethernet0 = &emac;
 		serial0 = &uart0;
 		spi0 = &spi0;
 	};
@@ -78,6 +79,11 @@
 	};
 };
 
+&emac {
+	allwinner,leds-active-low;
+ 	status = "okay";
+};
+
 &mmc0 {
 	broken-cd;
 	bus-width = <4>;
